{
  "$schema": "https://unpkg.com/knip/schema.json",
  "project": ["src/**/*.{ts,tsx,css}", "*.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    // Executed by shared Moon tasks under .moon/tasks.
    "@biomejs/biome",
    // Reserved for the chart implementation, whose API is designed separately.
    "lightweight-charts"
  ]
}
